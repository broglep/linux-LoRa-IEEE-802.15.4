/dts-v1/;
/plugin/;

/ {
	fragment@0 {
		target = <&spi>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;

			spidev@0 {
				status = "disabled";
			};

			spidev@1 {
				status = "disabled";
			};
			
			sx1278@0 {
				compatible = "semtech,sx1276";
				reg = <0>;
				status = "okay";
				spi-max-frequency = <2000000>;
				clock-frequency = <32000000>;
				center-carrier-frq = <869525000>;
				rf-bandwidth = <250000>;
				spreading-factor = <7>;
				minimal-RF-channel = /bits/ 8 <11>;
				maximum-RF-channel = /bits/ 8 <11>;
			};

			sx1278@1 {
				compatible = "semtech,sx1276";
				reg = <1>;
				status = "okay";
				spi-max-frequency = <2000000>;
				clock-frequency = <32000000>;
				center-carrier-frq = <869525000>;
				rf-bandwidth = <250000>;
				spreading-factor = <7>;
				minimal-RF-channel = /bits/ 8 <11>;
				maximum-RF-channel = /bits/ 8 <11>;
			};
		};
	};
};
